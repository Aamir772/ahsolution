# ============================================================================
# AH Solution — JARVIS assistant backend (server/) — example configuration
#
# Copy to server/.env (or export these in your shell) and fill in only what you
# need. ALL VALUES ARE EXAMPLES — never commit real secrets.
#
# The server runs with ZERO required variables: with AH_PROVIDER=none it answers
# from the bundled site knowledge index only. Add a provider when ready.
# ============================================================================

# --- runtime ---------------------------------------------------------------
AH_ASSISTANT_ENV=development
AH_ASSISTANT_HOST=127.0.0.1
AH_ASSISTANT_PORT=8787
AH_ASSISTANT_LOG_LEVEL=info
# Comma-separated. Required (and must not be "*") when AH_ASSISTANT_ENV=production.
AH_ASSISTANT_ALLOWED_ORIGINS=http://localhost:8000

# --- model provider (cloud + optional local) -------------------------------
# none | openai | gemini | local | openai-compatible
AH_PROVIDER=none
AH_MODEL=
# Cloud key (leave empty for local/none). NEVER expose this to the browser.
AH_API_KEY=
# Cloud endpoint for openai-compatible providers.
AH_BASE_URL=https://api.openai.com/v1
# Local model server (Ollama / LM Studio / vLLM speak the same API).
AH_LOCAL_ENABLED=0
AH_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AH_LOCAL_MODEL=llama3.1
# cloud-first | local-first | local-only | cloud-only
AH_ROUTING=cloud-first
AH_MAX_OUTPUT_TOKENS=700
AH_PROVIDER_TIMEOUT_MS=20000

# --- limits ----------------------------------------------------------------
AH_RATE_LIMIT=20
AH_RATE_WINDOW_MS=60000
AH_DAILY_LIMIT=200
AH_MAX_BODY_BYTES=32768
AH_REQUEST_TIMEOUT_MS=30000
# If 1, the server refuses to start a cloud model without a durable limiter.
AH_REQUIRE_DURABLE_LIMIT=0

# --- authentication --------------------------------------------------------
# Development-only admin bearer token. FORBIDDEN in production (use Supabase).
AH_ADMIN_TOKEN=
# Bearer token for the pre-existing "agent" HTTP API principal. NOT the local
# PC agent credential — see the "local agent" section below.
AH_AGENT_TOKEN=
# HMAC secret for sessions / agent messages. Required (>=24 chars) in production.
AH_SESSION_SECRET=

# --- Supabase admin (optional; reuses the site's project) ------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Admin allowlist (comma-separated emails).
ADMIN_EMAILS=

# --- storage / features ----------------------------------------------------
# memory | jsonfile
AH_STORAGE_DRIVER=jsonfile
AH_DATA_DIR=server/.data
AH_ENABLE_TOOLS=1
AH_ENABLE_VOICE=0

# --- local Windows agent hub (Milestone 4) ---------------------------------
# The agent is a SEPARATE process (agent/) that connects OUTBOUND to this
# backend, so the PC never opens an inbound control port. Off by default.
AH_ENABLE_AGENT=0
# Hub bind address. Loopback only by default; set AH_AGENT_TLS=1 before
# exposing this anywhere non-local (enforced in production).
AH_AGENT_HOST=127.0.0.1
AH_AGENT_PORT=8788
# Default identity when only one agent token is supplied.
AH_AGENT_ID=local-agent
# Revocable credential the agent presents at handshake. Use AH_AGENT_HUB_TOKENS
# (a JSON map of { "agentId": "token" }) when you run more than one PC.
# Keep this DIFFERENT from AH_AGENT_TOKEN (that one is the HTTP API principal).
AH_AGENT_HUB_TOKEN=
# AH_AGENT_HUB_TOKENS={"office-pc":"example-hub-token-1","lab-pc":"example-hub-token-2"}
# Optional dedicated HMAC secret for agent messages. Set it on BOTH the backend
# and the agent (agent/.env) so the agent process never holds the HTTP session
# secret. Falls back to AH_SESSION_SECRET when empty.
AH_AGENT_SESSION_SECRET=
# Liveness / bounds. The hub drops an agent that stops heartbeating.
AH_AGENT_HEARTBEAT_MS=15000
AH_AGENT_STALE_MS=45000
AH_AGENT_CLOCK_SKEW_MS=60000
AH_AGENT_MAX_MESSAGE_BYTES=262144
AH_AGENT_MAX_CONCURRENT=2
AH_AGENT_TASK_TIMEOUT_MS=120000
# Backend-side allowlists (defence in depth; the agent enforces its own).
AH_AGENT_TOOLS=agent_status,files_list,files_read,project_inspect,qa_run
AH_AGENT_QA_SUITES=assistant-test,qa-ai,qa-pages,qa-device,qa-scroll,qa-admin
# TLS for a remote hub: AH_AGENT_TLS=1 plus key/cert/CA files.
AH_AGENT_TLS=0
AH_AGENT_TLS_KEY=
AH_AGENT_TLS_CERT=
AH_AGENT_TLS_CA=

# --- bounded workflow automation (Milestone 5) -----------------------------
# Registry + engine for named, approval-gated workflows (workflow-scope runs
# are separate from plain tasks). Off = HTTP/chat report workflow_unsupported.
AH_ENABLE_WORKFLOWS=1
# Max concurrently active workflow runs (queued/running/waiting) per process.
AH_WORKFLOW_MAX_CONCURRENT=3
# Whole-run deadline; a run that exceeds it is marked timed_out honestly.
AH_WORKFLOW_TIMEOUT_MS=900000
# Approval windows: how long a waiting run stays approvable before it fails
# with "approval expired" (5s..24h). Applies to workflow-scope and step-scope
# (unconfirmed write) approvals.
AH_WORKFLOW_APPROVAL_TTL_MS=900000
# Comma-separated tool names allowed to run WITHOUT an approval for
# write-class steps. Default is draft-only: nothing destructive autoplays.
AH_WORKFLOW_AUTO_WRITE_TOOLS=draft_write
# Result/side-effect bound: per-step tool results are truncated to this many
# bytes when written onto the run record.
AH_WORKFLOW_MAX_RESULT_BYTES=16384

# --- scheduler (Milestone 5; SINGLE-INSTANCE by design) -------------------
# The background loop NEVER starts unless this is 1 (jobs also default to
# enabled=false — both opt-ins are required before anything recurs).
AH_SCHEDULER_ENABLED=0
# Loop cadence. Note: manual ticks (tests, ops) use scheduler.tick(atMs).
AH_SCHEDULER_TICK_MS=30000
# IANA timezone used for daily recurrences and the maxRunsPerDay bucket.
AH_SCHEDULER_TZ=UTC
# How late a slot may fire before the misfire policy applies (5min default).
AH_SCHEDULER_MISFIRE_GRACE_MS=300000
# skip (default, record the miss and move on) | run-once (one catch-up run).
AH_SCHEDULER_MISFIRE_POLICY=skip
# How many scheduled runs may be active at once (budget checked per tick;
# extra jobs stay due and fire on the next tick inside the misfire window).
AH_SCHEDULER_MAX_CONCURRENT=3
# Per-job history cap kept on each schedule record (oldest entries dropped).
AH_SCHEDULER_MAX_HISTORY=50
