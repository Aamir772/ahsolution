# ============================================================================
# AH Solution — local Windows agent (agent/) — example configuration
#
# The agent is a SEPARATE process from the hosted backend. It connects OUTBOUND
# to the backend, so your PC never opens an inbound control port. Copy this file
# to agent/.env (or export the variables in your shell) and fill in the blanks.
# ALL VALUES ARE EXAMPLES — never commit real secrets.
#
# Start:   npm run agent          (or: node agent/index.js)
# Stop:    Ctrl+C
# ============================================================================

# --- where the backend is ---------------------------------------------------
# Loopback for local development. For a remote backend use the server's real
# hostname/IP together with AH_AGENT_TLS=1 and a CA you trust.
AH_AGENT_BACKEND_HOST=127.0.0.1
AH_AGENT_BACKEND_PORT=8788

# --- identity + credentials -------------------------------------------------
# Must be a key in the backend's AH_AGENT_HUB_TOKENS map (or match the single
# AH_AGENT_HUB_TOKEN when the backend uses its AH_AGENT_ID default).
AH_AGENT_ID=local-agent
# Revocable hub token. Must match the backend's AH_AGENT_HUB_TOKEN exactly.
AH_AGENT_HUB_TOKEN=
# Shared HMAC secret (>= 16 chars). Must match the backend's
# AH_AGENT_SESSION_SECRET, or fall back to the backend's AH_SESSION_SECRET.
AH_AGENT_SESSION_SECRET=

# --- TLS (required for a remote backend) -----------------------------------
# The agent does NOT verify an unencrypted remote connection by default.
AH_AGENT_TLS=0
# PEM bundle used to verify the backend's certificate.
AH_AGENT_TLS_CA=
# Override the certificate's server name if needed.
AH_AGENT_TLS_SERVERNAME=
# Development only. Never set this for a remote backend: it disables the
# certificate check and enables credential interception.
AH_AGENT_TLS_INSECURE=0

# --- what the agent is allowed to touch ------------------------------------
# Approved roots. The agent refuses any path outside these, including symlinks,
# device paths and anything that resolves outside after normalisation.
# Defaults to the current working directory when empty.
AH_AGENT_ROOTS=F:\AI Project\AH Solution
# Hard caps on what a task may consume.
AH_AGENT_MAX_FILE_BYTES=262144
AH_AGENT_MAX_OUTPUT_BYTES=65536
AH_AGENT_MAX_CONCURRENT=1
AH_AGENT_HEARTBEAT_MS=15000
AH_AGENT_RECONNECT_MIN_MS=500
AH_AGENT_RECONNECT_MAX_MS=15000

# --- QA suites --------------------------------------------------------------
# Only these ids are runnable, and only through the fixed executable below.
AH_AGENT_QA_SUITES=assistant-test,qa-ai,qa-pages,qa-device,qa-scroll,qa-admin
# Optional overrides: map an id to a different argument list. The executable is
# ALWAYS the node binary that started the agent; no shell is ever used.
# AH_AGENT_QA_MAP={"qa-pages":{"args":["scripts/qa-pages.cjs"]}}
AH_AGENT_QA_MAP=

# debug | info | warn | error. Never log secrets — the agent will not.
AH_AGENT_LOG_LEVEL=info
