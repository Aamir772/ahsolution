# ==========================================================================
# AH Solution — Supabase + Netlify Environment Variables
# Never commit .env files or expose credentials in frontend assets.
# Set these in the Netlify dashboard (Site > Settings > Build & deploy >
# Environment variables). For local development, copy this file to .env.
# ==========================================================================

# --------------------------------------------------------------------------
# Supabase (get at https://supabase.com)
# --------------------------------------------------------------------------
# Project URL — used by every Netlify Function.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Publishable (anon) key — used only server-side by the admin-auth function
# for the GoTrue password grant, so it never ships to the browser.
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Service-role key — FULLY PRIVILEGED. Only the Netlify Functions may read it.
# Never expose it client-side, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --------------------------------------------------------------------------
# Admin panel
# --------------------------------------------------------------------------
# Comma-separated allowlist of administrator email addresses. Required for
# admin login to succeed (falls back to the app_metadata role claim only
# when this is empty).
ADMIN_EMAILS=you@example.com

# One-time shared secret required by /.netlify/functions/init-admin when
# creating the first administrator. Unset = bootstrap disabled.
ADMIN_SETUP_TOKEN=choose-a-long-random-string

# --------------------------------------------------------------------------
# CORS (optional)
# --------------------------------------------------------------------------
# Extra allowed origins for function CORS, comma-separated. localhost,
# 127.0.0.1, ah solution.live and www.ahsolution.live are always allowed.
ALLOWED_ORIGINS=

# --------------------------------------------------------------------------
# Netlify
# --------------------------------------------------------------------------
NETLIFY_SITE_ID=YOUR_SITE_ID

# --------------------------------------------------------------------------
# AI (optional — retained from existing solution-ai-chat function)
# --------------------------------------------------------------------------
# These are the same variables the existing solution-ai-chat function uses.
# Leave unset or set to "none" for knowledge-only mode.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_DISABLED=1
AI_REQUIRE_DURABLE_LIMIT=1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_RATE_LIMIT=10
AI_RATE_WINDOW_MS=600000
AI_DAILY_LIMIT=40
AI_MAX_OUTPUT_TOKENS=450

# --------------------------------------------------------------------------
# Localization (optional — global language selector, Gemini translation)
# --------------------------------------------------------------------------
# Google AI Studio key for the Gemini API (https://aistudio.google.com/apikey).
# Server-side only: the localize Netlify Function reads it from process.env,
# and it must never be exposed to the browser or committed to Git.
# Get the key in Google AI Studio, then set it in the Netlify dashboard with
# this exact variable name.
GEMINI_API_KEY=

# Fixed model used by the localization endpoint (no automatic upgrade or
# billing-tier switching). gemini-2.5-flash is a current documented model id.
LOCALIZE_MODEL=gemini-2.5-flash

# Per-IP rate limits for /api/localize.
LOCALIZE_RATE_LIMIT=20
LOCALIZE_RATE_WINDOW_MS=600000
LOCALIZE_DAILY_LIMIT=300

# Safety default "1": translation stays disabled unless a durable rate limiter
# (Upstash below) is configured, mirroring solution-ai-chat. Set to "0" to run
# with the in-memory limiter only (smaller instances can be conservative).
LOCALIZE_REQUIRE_DURABLE_LIMIT=1

# --------------------------------------------------------------------------
# Site
# --------------------------------------------------------------------------
SITE_URL=https://ahsolution.live
